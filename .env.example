# Django Settings (names must match config/settings.py)
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional locally — SQLite is used when DATABASE_URL is unset)
# DATABASE_URL=postgres://user:password@localhost:5432/lendstack

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# CORS / CSRF (include frontend dev ports)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Flinks (IBV Provider)
# Instance can be: toolbox, demo, or your custom instance
FLINKS_INSTANCE=toolbox
FLINKS_CUSTOMER_ID=your-flinks-customer-id
FLINKS_SECRET_KEY_CA=your-flinks-secret-key-ca
FLINKS_WEBHOOK_SECRET=your-flinks-webhook-secret

# ZūmRails (Funding / Collections)
ZUMRAILS_API_BASE_URL=https://api.zumrails.com
ZUMRAILS_API_KEY=your-zumrails-api-key
ZUMRAILS_WEBHOOK_SECRET=your-zumrails-webhook-secret
ZUMRAILS_DRY_RUN=True

# DocuSign (E-Signatures)
DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
DOCUSIGN_SECRET_KEY=your-docusign-secret-key
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@lendstack.com

# Inbound Email polling
INBOUND_EMAIL_PROVIDER=graph
INBOUND_EMAIL_POLL_ENABLED=False
INBOUND_EMAIL_POLL_LIMIT=50

# Microsoft Graph inbound email
GRAPH_TENANT_ID=your-azure-tenant-id
GRAPH_CLIENT_ID=your-azure-app-client-id
GRAPH_CLIENT_SECRET=your-azure-app-client-secret-value
GRAPH_MAILBOX=info@nojuice.ca

# IMAP fallback inbound email
INBOUND_EMAIL_HOST=outlook.office365.com
INBOUND_EMAIL_PORT=993
INBOUND_EMAIL_USER=info@nojuice.ca
INBOUND_EMAIL_PASSWORD=your-inbound-mailbox-password
INBOUND_EMAIL_MAILBOX=INBOX

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=lendstack-files
AWS_S3_REGION_NAME=us-east-1

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn

# Bootstrap admin (optional — run: python manage.py ensure_admin)
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
# BOOTSTRAP_ADMIN_FULL_NAME=Admin User

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
