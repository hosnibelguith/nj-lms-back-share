# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://user:password@localhost:5432/lendstack

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Flinks (IBV Provider)
# Instance can be: toolbox, demo, or your custom instance
FLINKS_INSTANCE=toolbox
FLINKS_CUSTOMER_ID=your-flinks-customer-id
FLINKS_SECRET_KEY_CA=your-flinks-secret-key-ca
FLINKS_WEBHOOK_SECRET=your-flinks-webhook-secret

# DocuSign (E-Signatures)
DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
DOCUSIGN_SECRET_KEY=your-docusign-secret-key
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@lendstack.com

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=lendstack-files
AWS_S3_REGION_NAME=us-east-1

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
